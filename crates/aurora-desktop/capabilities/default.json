{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Aurora's own commands and the folder dialog; nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-projects",
    "allow-add-project",
    "allow-pick-and-add-project",
    "allow-rename-project",
    "allow-remove-project",
    "allow-relocate-project",
    "allow-engines-overview",
    "allow-refresh-engines",
    "allow-get-settings",
    "allow-save-settings",
    "allow-project-cycle-state"
  ]
}
