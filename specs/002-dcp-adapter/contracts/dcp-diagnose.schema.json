{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://levix.digital/schemas/dcp/diagnose-1.json",
  "title": "dcp diagnose reply (schema MAJOR 1)",
  "description": "What Aurora expects from `dcp diagnose --json --dir <root>`, offered when `dcp version --json` lists the capability `diagnose` with schema_major 1. Unknown fields are ignored; MINOR versions only add optional fields. Exit code 0 with this reply on standard output; any other exit code is a failure and standard error explains it.",
  "type": "object",
  "required": ["schema", "schema_version", "root", "summary", "next", "release", "plans", "release_candidate", "pull_requests", "bugs", "findings"],
  "properties": {
    "schema": { "const": "dcp.diagnose" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "root": { "type": "string", "description": "The repository root the reply is about (absolute path)" },
    "summary": { "type": "string", "description": "One line on where the project stands" },
    "next": {
      "type": "object",
      "required": ["ask", "recommended", "options"],
      "properties": {
        "ask": { "type": "boolean", "description": "true when whoever runs the protocol must choose before work goes on" },
        "recommended": { "type": ["string", "null"], "description": "The key of the recommended option" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "title"],
            "properties": {
              "key": { "type": "string", "description": "Stable key, for example plan:<id>, pr:<number>, rc:<run>, bugs, triage, release, request" },
              "title": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "release": {
      "type": ["object", "null"],
      "description": "The current release of the roadmap (the first one not released); null without a roadmap",
      "required": ["version", "name", "open_items"],
      "properties": {
        "version": { "type": "string" },
        "name": { "type": "string" },
        "open_items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "plans": {
      "type": "array",
      "description": "Plans in progress (status active or in_progress)",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "milestones_done", "milestones_total"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "milestones_done": { "type": "integer", "minimum": 0 },
          "milestones_total": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "release_candidate": {
      "type": ["object", "null"],
      "description": "The latest release candidate run of the manual test suite; null when there is none",
      "required": ["run", "version", "not_run", "failed", "released"],
      "properties": {
        "run": { "type": "string", "description": "For example v0.2.0-rc.1" },
        "version": { "type": "string" },
        "not_run": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0, "description": "Fail and Blocked results" },
        "released": { "type": "boolean" }
      }
    },
    "pull_requests": {
      "type": "array",
      "description": "Open pull requests on the project's platform; empty with a finding when the platform cannot be read",
      "items": {
        "type": "object",
        "required": ["number", "title", "summary", "needs_action", "threads_for_user"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "needs_action": { "type": "boolean" },
          "threads_for_user": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "bugs": {
      "type": "object",
      "required": ["blocking", "untriaged"],
      "properties": {
        "blocking": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "untriaged": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/item" }],
            "required": ["reason"],
            "properties": { "reason": { "type": "string" } }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "What the engine could not read and why; never blocking for the reader",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "rank", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
        "rank": { "type": ["string", "null"], "description": "Priority of a feature, improvement or adjustment, severity of a bug; null when not set" },
        "title": { "type": "string" }
      }
    }
  }
}
